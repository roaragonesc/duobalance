{
  "name": "duobalance",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "scripts": {
    "backend:dev": "corepack pnpm --filter @duobalance/api run dev",
    "backend:build": "corepack pnpm --filter @duobalance/api run build",
    "backend:lint": "corepack pnpm --filter @duobalance/api run lint",
    "backend:seed": "corepack pnpm --filter @duobalance/api run seed",
    "dev": "corepack pnpm --filter @duobalance/web run dev",
    "dev:mock": "corepack pnpm --filter @duobalance/web run dev:mock",
    "dev:demo": "corepack pnpm --filter @duobalance/web run dev:demo",
    "build": "corepack pnpm --filter @duobalance/web run build && corepack pnpm --filter @duobalance/api run build",
    "build:demo": "corepack pnpm --filter @duobalance/web run build:demo",
    "preview:demo": "corepack pnpm --filter @duobalance/web run preview:demo",
    "lint": "corepack pnpm -r --if-present run lint",
    "preview": "corepack pnpm --filter @duobalance/web run preview",
    "check:architecture": "node --experimental-strip-types scripts/checkArchitecture.ts",
    "lint:arch": "node scripts/checkArchitecture.ts",
    "inventory:update": "node scripts/checkArchitecture.ts --write-inventory",
    "test:architecture": "node --test scripts/architecture.test.ts",
    "typecheck:tooling": "corepack pnpm --filter @duobalance/web exec tsc -p ../../scripts/tsconfig.json"
  }
}
