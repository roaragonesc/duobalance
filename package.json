{
  "name": "duobalance",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "backend:dev": "npm --prefix backend run dev",
    "backend:build": "npm --prefix backend run build",
    "backend:lint": "npm --prefix backend run lint",
    "test:api": "npm --prefix test-framework run test:api --",
    "test:e2e:api": "npm --prefix test-framework run test:e2e:api --",
    "test:fw:typecheck": "npm --prefix test-framework run typecheck",
    "dev": "vite",
    "dev:mock": "vite",
    "dev:demo": "vite --mode demo",
    "build": "tsc -b && vite build",
    "build:demo": "tsc -b && vite build --config vite.pages.config.ts --mode pages-demo",
    "preview:demo": "vite preview --config vite.pages.config.ts --mode pages-demo --host 127.0.0.1 --port 4175",
    "lint": "oxlint",
    "preview": "vite preview",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:status": "supabase status",
    "db:reset": "supabase db reset",
    "db:types": "supabase gen types typescript --local > src/lib/supabase/database.types.ts",
    "test": "npm --prefix test-framework test --",
    "test:e2e": "npm --prefix test-framework run test:e2e --",
    "test:demo": "npm run build:demo && npm --prefix test-framework run test:demo",
    "test:e2e:file": "npm --prefix test-framework run test:e2e --",
    "test:e2e:ui": "npm --prefix test-framework run test:e2e -- --ui",
    "test:e2e:debug": "npm --prefix test-framework run test:e2e -- --debug",
    "test:db": "npm --prefix test-framework run test:db --",
    "test:unit": "npm --prefix test-framework run test:unit --"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "@tailwindcss/vite": "^4.3.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "embedded-postgres": "^17.11.0-beta.19",
    "jsdom": "^30.1.3",
    "oxlint": "^1.89.0",
    "pg": "^8.23.1",
    "supabase": "^3.0.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
