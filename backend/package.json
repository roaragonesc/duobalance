{
  "name": "duobalance-backend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": { "node": ">=22.22.0" },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx --watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "lint": "oxlint src",
    "seed": "node --import tsx src/seeds/run.ts"
  },
  "dependencies": {
    "argon2": "^0.44.0",
    "cookie": "^1.0.2",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "express-rate-limit": "^8.2.0",
    "helmet": "^8.1.0",
    "mongoose": "^8.19.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^24.19.2",
    "oxlint": "^1.89.0",
    "tsx": "^4.20.0",
    "typescript": "~7.0.2"
  }
}
