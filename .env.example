# Copia este archivo como .env.local y rellena los valores de tu proyecto.
# Solo valores PÚBLICOS: todo lo que empieza por VITE_ se incluye en el navegador.
# Nunca pongas aquí la service_role key ni la secret key.

# Por defecto Vite usa datos mock durante el desarrollo. Cambia a "supabase"
# cuando quieras conectar el frontend al proyecto configurado abajo.
VITE_DATA_MODE=mock

# Local (npm run db:start): API URL y Publishable key que muestra `supabase status`.
# Cloud: Project Settings → API (URL del proyecto y publishable/anon key).
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
