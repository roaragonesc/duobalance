# Copia este archivo como .env.local para configurar el frontend.
# Todo valor VITE_ se incluye en el navegador: no añadas secretos aquí.

# Por defecto Vite usa datos mock durante el desarrollo. Usa "api" para conectar
# el frontend con la API Express.
VITE_DATA_MODE=mock
VITE_API_PROXY_TARGET=http://127.0.0.1:3001
