{
  "name": "@duobalance/web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "vite --mode api",
    "dev:mock": "vite",
    "dev:demo": "vite --mode demo",
    "build": "tsc -b && vite build",
    "build:demo": "tsc -b && vite build --config vite.pages.config.ts --mode pages-demo",
    "preview": "vite preview",
    "preview:demo": "vite preview --config vite.pages.config.ts --mode pages-demo --host 127.0.0.1 --port 4175",
    "lint": "oxlint",
    "test:unit": "node --import tsx --test tests/*.test.ts",
    "typecheck:unit": "tsc -p tsconfig.tests.json"
  },
  "dependencies": {
    "@duobalance/shared-schemas": "workspace:*",
    "@duobalance/shared-types": "workspace:*",
    "@tailwindcss/vite": "^4.3.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1",
    "tailwindcss": "^4.3.3",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.89.0",
    "tsx": "^4.20.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.5"
  }
}
