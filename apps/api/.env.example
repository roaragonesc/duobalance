NODE_ENV=development
HOST=127.0.0.1
PORT=3001
FRONTEND_ORIGIN=http://localhost:5173
# Replace privately with the Atlas Drivers URI (mongodb+srv://...) in .env.
# Encode special characters in credentials. Never put credentials in VITE_*.
# Local alternative requires a replica set; standalone MongoDB is rejected.
MONGODB_URI=mongodb://127.0.0.1:27017/?replicaSet=rs0
MONGODB_DATABASE=duobalance_dev
MAIL_DIRECTORY=.local-mail
# Set a fictitious password privately in apps/api/.env for the isolated seed.
SEED_PASSWORD=
