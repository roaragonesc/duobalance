{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "types": ["node"],
    "typeRoots": ["../apps/web/node_modules/@types"],
    "paths": {
      "typescript/*": ["../apps/web/node_modules/typescript/*"]
    }
  },
  "include": ["*.ts"]
}
